<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <meta name="full-screen" content="yes">
  <meta name="theme-color" content="#0a0e14">
  <title>Rally</title>
  <script src="https://telegram.org/js/telegram-web-app.js" async></script>
  <style>
    /* === ШРИФТЫ === */
    @font-face {
      font-family: 'Inter';
      font-style: normal;
      font-weight: 600;
      font-display: swap;
      src: url('./fonts/inter-600-cyrillic.woff2') format('woff2');
      unicode-range: U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116;
    }
    @font-face {
      font-family: 'Inter';
      font-style: normal;
      font-weight: 600;
      font-display: swap;
      src: url('./fonts/inter-600-latin.woff2') format('woff2');
      unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215;
    }
    @font-face {
      font-family: 'Inter';
      font-style: normal;
      font-weight: 700;
      font-display: swap;
      src: url('./fonts/inter-700-cyrillic.woff2') format('woff2');
      unicode-range: U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116;
    }
    @font-face {
      font-family: 'Inter';
      font-style: normal;
      font-weight: 700;
      font-display: swap;
      src: url('./fonts/inter-700-latin.woff2') format('woff2');
      unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215;
    }
    @font-face {
      font-family: 'Inter';
      font-style: normal;
      font-weight: 800;
      font-display: swap;
      src: url('./fonts/inter-800-cyrillic.woff2') format('woff2');
      unicode-range: U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116;
    }
    @font-face {
      font-family: 'Inter';
      font-style: normal;
      font-weight: 800;
      font-display: swap;
      src: url('./fonts/inter-800-latin.woff2') format('woff2');
      unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215;
    }

    /* === БАЗА === */
    * { 
      margin: 0; 
      padding: 0; 
      box-sizing: border-box; 
      -webkit-tap-highlight-color: transparent;
    }
    
    :root {
      --bg: #0a0e14;
      --glass: rgba(20, 25, 35, 0.7);
      --glass-border: rgba(255, 255, 255, 0.08);
      --accent: #00e5ff;
      --accent-2: #ff3d00;
      --text: #ffffff;
      --text-dim: #8a94a6;
      --shadow-lg: 0 20px 60px rgba(0, 0, 0, 0.5);
      --shadow-md: 0 8px 24px rgba(0, 0, 0, 0.4);
    }
    
    html, body {
      width: 100%; 
      height: 100vh; 
      height: 100dvh;
      overflow: hidden; 
      background: var(--bg);
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      font-weight: 600;
      color: var(--text);
      touch-action: none;
      position: fixed;
      inset: 0;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      -webkit-user-select: none;
      user-select: none;
    }
    
    canvas { display: block; width: 100%; height: 100%; }
    
    /* === HUD === */
    #timer, #speed {
      position: fixed;
      top: 12px;
      background: var(--glass);
      backdrop-filter: blur(20px) saturate(180%);
      -webkit-backdrop-filter: blur(20px) saturate(180%);
      border: 1px solid var(--glass-border);
      border-radius: 16px;
      padding: 10px 20px;
      color: var(--text);
      font-family: 'Inter', sans-serif;
      font-variant-numeric: tabular-nums;
      font-feature-settings: "tnum";
      font-size: 24px;
      font-weight: 800;
      letter-spacing: 0.5px;
      text-align: center;
      z-index: 100;
      pointer-events: none;
      box-shadow: var(--shadow-md);
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    
    #timer {
      left: 50%;
      transform: translateX(-50%) translateX(-85px);
      min-width: 140px;
    }
    
    #speed {
      left: 50%;
      transform: translateX(-50%) translateX(85px);
      min-width: 120px;
    }
    
    #speed .unit {
      display: block;
      font-size: 11px;
      font-weight: 600;
      opacity: 0.4;
      letter-spacing: 2px;
      margin-top: 2px;
      text-transform: uppercase;
    }
    
    /* === КНОПКА МЕНЮ === */
    #btn-menu {
      position: fixed;
      top: 12px; 
      right: 12px;
      width: 52px; 
      height: 52px;
      background: var(--glass);
      backdrop-filter: blur(20px) saturate(180%);
      -webkit-backdrop-filter: blur(20px) saturate(180%);
      border: 1px solid var(--glass-border);
      border-radius: 16px;
      color: var(--text);
      font-size: 20px;
      display: none;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      z-index: 100;
      box-shadow: var(--shadow-md);
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }
    #btn-menu.show { display: flex; }
    #btn-menu:active {
      transform: scale(0.92);
      background: rgba(0, 229, 255, 0.15);
      border-color: rgba(0, 229, 255, 0.4);
    }
    
    /* === КНОПКИ УПРАВЛЕНИЯ === */
    .btn-control {
      position: fixed;
      pointer-events: auto;
      background: var(--glass);
      backdrop-filter: blur(20px) saturate(180%);
      -webkit-backdrop-filter: blur(20px) saturate(180%);
      border: 1px solid var(--glass-border);
      border-radius: 50%;
      color: var(--text);
      font-size: 24px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      touch-action: none;
      transition: all 0.15s cubic-bezier(0.4, 0, 0.2, 1);
      z-index: 20;
      box-shadow: var(--shadow-md);
      overflow: hidden;
    }
    
    .btn-control::before {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at 50% 50%, 
        rgba(0, 229, 255, 0) 0%, 
        rgba(0, 229, 255, 0.3) 100%);
      opacity: 0;
      transition: opacity 0.2s;
      pointer-events: none;
    }
    
    .btn-control:active {
      transform: scale(0.9);
      background: rgba(0, 229, 255, 0.2);
      border-color: rgba(0, 229, 255, 0.6);
    }
    
    .btn-control:active::before {
      opacity: 1;
    }
    
    .btn-control svg {
      width: 28px;
      height: 28px;
      fill: currentColor;
      position: relative;
      z-index: 1;
    }
    
    #btn-gas { bottom: 110px; right: 20px; width: 84px; height: 84px; }
    #btn-brake { bottom: 20px; right: 20px; width: 84px; height: 84px; }
    #btn-left { bottom: 60px; left: 20px; width: 84px; height: 84px; }
    #btn-right { bottom: 60px; left: 124px; width: 84px; height: 84px; }
    
    /* === МОДАЛКИ === */
    .modal {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.4);
      backdrop-filter: blur(20px) saturate(180%);
      -webkit-backdrop-filter: blur(20px) saturate(180%);
      display: none;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      z-index: 200;
      padding: 24px;
      animation: fadeIn 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .modal.show { display: flex; }
    
    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }
    
    .modal-panel {
      width: 100%;
      max-width: 380px;
      background: var(--glass);
      backdrop-filter: blur(40px) saturate(180%);
      -webkit-backdrop-filter: blur(40px) saturate(180%);
      border: 1px solid var(--glass-border);
      border-radius: 28px;
      padding: 32px 24px 24px;
      box-shadow: var(--shadow-lg);
      animation: slideUp 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    
    @keyframes slideUp {
      from { 
        transform: translateY(20px) scale(0.96);
        opacity: 0;
      }
      to { 
        transform: translateY(0) scale(1);
        opacity: 1;
      }
    }
    
    .modal-icon {
      width: 72px;
      height: 72px;
      margin: 0 auto 20px;
      background: linear-gradient(135deg, var(--accent), var(--accent-2));
      border-radius: 22px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 36px;
      box-shadow: 0 12px 40px rgba(0, 229, 255, 0.4);
    }
    
    .modal-title {
      font-size: 28px;
      font-weight: 800;
      color: var(--text);
      text-align: center;
      letter-spacing: -0.5px;
      margin-bottom: 6px;
    }
    
    .modal-subtitle {
      font-size: 14px;
      font-weight: 600;
      color: var(--text-dim);
      text-align: center;
      margin-bottom: 28px;
      letter-spacing: 0.2px;
    }
    
    .modal-time {
      font-size: 48px;
      font-weight: 800;
      font-variant-numeric: tabular-nums;
      font-feature-settings: "tnum";
      color: var(--accent);
      text-align: center;
      letter-spacing: -1px;
      margin-bottom: 28px;
      text-shadow: 0 0 40px rgba(0, 229, 255, 0.5);
    }
    
    .modal-buttons {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    
    /* === СОВРЕМЕННЫЕ КНОПКИ === */
    .modal-btn {
      position: relative;
      padding: 16px 20px;
      font-size: 16px;
      font-weight: 700;
      color: var(--text);
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid var(--glass-border);
      border-radius: 16px;
      cursor: pointer;
      transition: all 0.15s cubic-bezier(0.4, 0, 0.2, 1);
      user-select: none;
      touch-action: manipulation;
      font-family: inherit;
      display: flex;
      align-items: center;
      gap: 14px;
      text-align: left;
      overflow: hidden;
    }
    
    .modal-btn .icon {
      font-size: 22px;
      width: 32px;
      text-align: center;
      flex-shrink: 0;
    }
    
    .modal-btn .label {
      flex: 1;
      letter-spacing: 0.2px;
    }
    
    .modal-btn .arrow {
      font-size: 18px;
      opacity: 0.4;
      flex-shrink: 0;
      transition: transform 0.2s, opacity 0.2s;
    }
    
    .modal-btn::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(90deg, 
        rgba(0, 229, 255, 0.15) 0%, 
        rgba(0, 229, 255, 0) 100%);
      opacity: 0;
      transition: opacity 0.2s;
    }
    
    .modal-btn:active {
      transform: scale(0.98);
      background: rgba(0, 229, 255, 0.1);
      border-color: rgba(0, 229, 255, 0.3);
    }
    
    .modal-btn:active::before {
      opacity: 1;
    }
    
    .modal-btn:active .arrow {
      transform: translateX(4px);
      opacity: 0.8;
    }
    
    .modal-btn.primary {
      background: linear-gradient(135deg, 
        rgba(0, 229, 255, 0.2), 
        rgba(255, 61, 0, 0.15));
      border-color: rgba(0, 229, 255, 0.4);
      box-shadow: 0 8px 24px rgba(0, 229, 255, 0.15);
    }
    
    .modal-btn.primary:active {
      background: linear-gradient(135deg, 
        rgba(0, 229, 255, 0.35), 
        rgba(255, 61, 0, 0.25));
      box-shadow: 0 4px 16px rgba(0, 229, 255, 0.3);
    }
    
    /* === COUNTDOWN === */
    #countdown {
      position: fixed;
      inset: 0;
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 250;
      pointer-events: none;
    }
    #countdown.show { display: flex; }
    
    #countdown-number {
      font-size: 220px;
      font-weight: 800;
      color: var(--text);
      font-variant-numeric: tabular-nums;
      letter-spacing: -8px;
      text-shadow: 
        0 0 80px rgba(0, 229, 255, 0.9),
        0 0 200px rgba(0, 229, 255, 0.6),
        0 0 4px rgba(255, 255, 255, 0.8);
      animation: countdownPulse 1s cubic-bezier(0.4, 0, 0.2, 1);
    }
    
    @keyframes countdownPulse {
      0% { 
        transform: scale(0.3); 
        opacity: 0; 
      }
      50% { 
        transform: scale(1.1); 
        opacity: 1; 
      }
      100% { 
        transform: scale(1); 
        opacity: 1; 
      }
    }
    
    #countdown-number.go {
      color: #4ade80;
      text-shadow: 
        0 0 80px rgba(74, 222, 128, 1),
        0 0 200px rgba(74, 222, 128, 0.8),
        0 0 4px rgba(255, 255, 255, 0.9);
    }
  </style>
</head>
<body>
  <canvas id="game"></canvas>
  
  <div id="timer">00:00.00</div>
  <div id="speed">0<span class="unit">km/h</span></div>
  <div id="btn-menu">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
      <line x1="4" y1="7" x2="20" y2="7"/>
      <line x1="4" y1="12" x2="20" y2="12"/>
      <line x1="4" y1="17" x2="20" y2="17"/>
    </svg>
  </div>
  
  <div id="btn-gas" class="btn-control">
    <svg viewBox="0 0 24 24"><path d="M12 4l8 12H4z"/></svg>
  </div>
  <div id="btn-brake" class="btn-control">
    <svg viewBox="0 0 24 24"><path d="M12 20l-8-12h16z"/></svg>
  </div>
  <div id="btn-left" class="btn-control">
    <svg viewBox="0 0 24 24"><path d="M4 12l12-8v16z"/></svg>
  </div>
  <div id="btn-right" class="btn-control">
    <svg viewBox="0 0 24 24"><path d="M20 12l-12 8V4z"/></svg>
  </div>
  
  <div id="start-modal" class="modal show">
    <div class="modal-panel">
      <div class="modal-icon">🏁</div>
      <div class="modal-title">Rally</div>
      <div class="modal-subtitle">Telegram Mini App</div>
      <div class="modal-buttons">
        <button class="modal-btn primary" id="btn-start-race">
          <span class="icon">🏁</span>
          <span class="label">Начать круг</span>
          <span class="arrow">→</span>
        </button>
        <button class="modal-btn" id="btn-start-free">
          <span class="icon">🌍</span>
          <span class="label">Свободная езда</span>
          <span class="arrow">→</span>
        </button>
      </div>
    </div>
  </div>
  
  <div id="arch-modal" class="modal">
    <div class="modal-panel">
      <div class="modal-icon">⚡</div>
      <div class="modal-title">Старт</div>
      <div class="modal-subtitle">Ты у арки</div>
      <div class="modal-buttons">
        <button class="modal-btn primary" id="btn-arch-race">
          <span class="icon">🏁</span>
          <span class="label">Начать круг</span>
          <span class="arrow">→</span>
        </button>
        <button class="modal-btn" id="btn-arch-newtrack">
          <span class="icon">🛠</span>
          <span class="label">Сгенерировать трассу</span>
          <span class="arrow">→</span>
        </button>
        <button class="modal-btn" id="btn-arch-close">
          <span class="icon">✖</span>
          <span class="label">Продолжить езду</span>
          <span class="arrow">→</span>
        </button>
      </div>
    </div>
  </div>
  
  <div id="finish-modal" class="modal">
    <div class="modal-panel">
      <div class="modal-icon">🏆</div>
      <div class="modal-title">Финиш</div>
      <div class="modal-time" id="finish-time">00:00.00</div>
      <div class="modal-buttons">
        <button class="modal-btn primary" id="btn-retry">
          <span class="icon">🔄</span>
          <span class="label">Заново</span>
          <span class="arrow">→</span>
        </button>
        <button class="modal-btn" id="btn-new-world">
          <span class="icon">🌍</span>
          <span class="label">Новая карта</span>
          <span class="arrow">→</span>
        </button>
      </div>
    </div>
  </div>
  
  <div id="countdown">
    <div id="countdown-number">3</div>
  </div>
  
  <script type="module" src="/src/main.ts"></script>
</body>
</html>
